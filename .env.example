# Leave these blank to run on the built-in local-storage data layer (no backend needed).
# Fill them in to switch the whole app over to Supabase — no code changes required.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only used by the local-storage data layer: the passcode for the login screen.
# Ignored once Supabase is configured (real Supabase email/password auth takes over).
VITE_LOCAL_PASSCODE=silver
